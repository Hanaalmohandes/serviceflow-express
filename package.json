{
  "name": "serviceflow-express",
  "version": "1.0.0",
  "packageManager": "pnpm@11.15.1",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "pnpm run dev:api",
    "dev:api": "tsx --env-file=.env src/index.ts",
    "dev:frontend": "pnpm --dir frontend dev",
    "check": "tsc --noEmit",
    "build:frontend": "pnpm --dir frontend build"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.21.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
